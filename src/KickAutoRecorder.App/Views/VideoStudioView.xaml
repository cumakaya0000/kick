<UserControl x:Class="KickAutoRecorder.App.Views.VideoStudioView"
             x:Name="StudioViewRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="820" d:DesignWidth="1200">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/> <!-- Sol Panel -->
            <ColumnDefinition Width="*"/>    <!-- Orta Panel -->
            <ColumnDefinition Width="Auto"/> <!-- Right Splitter -->
            <ColumnDefinition Width="360" MinWidth="250" MaxWidth="800"/>  <!-- Sağ Panel -->
        </Grid.ColumnDefinitions>

        <!-- Right Panel Splitter -->
        <GridSplitter Grid.Column="2" Width="15" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" ShowsPreview="True" Cursor="SizeWE" ToolTip="Paneli Genişlet/Daralt"/>

        <!-- SOL PANEL: Kayıtlı Videolar Listesi -->
        <Border Grid.Column="0" Margin="0,0,15,0" Width="290" Visibility="{Binding IsLeftPanelVisible, Converter={StaticResource BoolToVis}}" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="📁 Kayıtlı Videolar" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="🔄 Yenile" Command="{Binding RefreshRecordingsCommand}" Background="#334155" Foreground="White" FontSize="11" Padding="6,3" Margin="0,0,4,0" Cursor="Hand" ToolTip="Kayıt Listesini Yenile"/>
                        <Button Content="↩️ Vazgeç" Command="{Binding ClearSelectionCommand}" Background="#475569" Foreground="White" FontSize="11" Padding="6,3" Cursor="Hand" ToolTip="Seçimi Temizle / Geri Adım"/>
                    </StackPanel>
                </Grid>

                <ListBox Grid.Row="1" ItemsSource="{Binding Recordings}" SelectedItem="{Binding SelectedRecording}" 
                         Background="Transparent" BorderThickness="0"
                         HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1E293B" CornerRadius="6" Padding="10" Margin="0,0,0,8" BorderBrush="#334155" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{Binding StreamerUsername}" FontWeight="Bold" Foreground="#38BDF8" FontSize="13"/>
                                    <TextBlock Text="{Binding StreamTitle}" TextWrapping="Wrap" FontSize="12" Foreground="White" Margin="0,2,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding StartedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" FontSize="11" Foreground="#94A3B8"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Resolution}" FontSize="11" Foreground="#A7F3D0" FontWeight="SemiBold"/>
                                    </Grid>
                                    <Grid Margin="0,4,0,0">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding FileSizeBytes, StringFormat={}{0:N0} B}" FontSize="10" Foreground="#64748B" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Status}" FontSize="10" Foreground="#F59E0B" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Button HorizontalAlignment="Right"
                                                Command="{Binding DataContext.DeleteRecordingCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                Content="Sil" Background="#EF4444" Foreground="White" 
                                                Padding="8,2" FontSize="10" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand">
                                            <Button.Resources>
                                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                                            </Button.Resources>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- ORTA PANEL: Video Preview & Timeline Trim -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Top Toolbar -->
                <RowDefinition Height="*"/>    <!-- Video Player -->
                <RowDefinition Height="Auto"/> <!-- Player Controls -->
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/> <!-- Bottom Timeline Trim Controls -->
            </Grid.RowDefinitions>

            <!-- Toggle Left Sidebar Button -->
            <ToggleButton Grid.Row="0" HorizontalAlignment="Left" Margin="0,0,0,10" 
                          IsChecked="{Binding IsLeftPanelVisible}"
                          Padding="10,5" Background="#334155" Foreground="White" BorderThickness="0" Cursor="Hand" ToolTip="Kayıtlı Videolar panelini göster/gizle">
                <ToggleButton.Resources>
                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                </ToggleButton.Resources>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="☰" FontSize="16" FontWeight="Bold" Margin="0,0,6,0"/>
                    <TextBlock Text="Videolar" VerticalAlignment="Center"/>
                </StackPanel>
            </ToggleButton>

            <!-- MediaElement Player Card -->
            <Border Grid.Row="1" Background="#000000" CornerRadius="8" ClipToBounds="True">
                <Grid>
                    <MediaElement x:Name="MediaPlayer" 
                                  Source="{Binding VideoSourceUri}" 
                                  LoadedBehavior="Manual" 
                                  UnloadedBehavior="Stop" 
                                  ScrubbingEnabled="True" 
                                  Stretch="Uniform"/>
                </Grid>
            </Border>

            <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6" Padding="10,6" Margin="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Play/Pause -->
                        <ColumnDefinition Width="Auto"/> <!-- Skip Buttons -->
                        <ColumnDefinition Width="*"/>    <!-- Slider -->
                        <ColumnDefinition Width="Auto"/> <!-- Position -->
                        <ColumnDefinition Width="Auto"/> <!-- Quick Trim Actions -->
                        <ColumnDefinition Width="100"/>  <!-- Volume -->
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button x:Name="BtnPlay" Content="▶ Oynat" Click="BtnPlay_Click" Margin="0,0,6,0" Padding="10,4" Background="#10B981" Foreground="White" FontWeight="Bold"/>
                        <Button x:Name="BtnPause" Content="⏸ Duraklat" Click="BtnPause_Click" Margin="0,0,6,0" Padding="10,4" Background="#64748B" Foreground="White"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,10,0">
                        <Button x:Name="BtnBackward" Content="⏪ -10s" Click="BtnBackward_Click" Margin="0,0,4,0" Padding="6,4" Background="#334155" Foreground="White" FontSize="11" ToolTip="10 saniye geri sar"/>
                        <Button x:Name="BtnForward" Content="⏩ +10s" Click="BtnForward_Click" Padding="6,4" Background="#334155" Foreground="White" FontSize="11" ToolTip="10 saniye ileri sar"/>
                    </StackPanel>

                    <!-- Timeline Slider -->
                    <Slider x:Name="TimelineSlider" Grid.Column="2" VerticalAlignment="Center" 
                            Minimum="0" Maximum="{Binding TotalDurationSeconds, FallbackValue=100}" 
                            Value="{Binding CurrentPositionSeconds, Mode=TwoWay}" 
                            ValueChanged="TimelineSlider_ValueChanged"/>

                    <!-- Position Display -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,10,0">
                        <TextBlock Text="{Binding CurrentPositionText}" FontWeight="Bold" Foreground="#38BDF8"/>
                        <TextBlock Text=" / " Foreground="#64748B"/>
                        <TextBlock Text="{Binding TotalDurationText}" Foreground="#94A3B8"/>
                    </StackPanel>
                    
                    <!-- Quick Trim Actions -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="0,0,15,0">
                        <Button Content="[ Başlangıç Seç" Command="{Binding SetTrimStartFromCurrentPositionCommand}" Margin="0,0,4,0" Padding="8,4" Background="#0284C7" Foreground="White" FontSize="11" FontWeight="Bold" ToolTip="Kırpma başlangıç noktasını buraya ayarla"/>
                        <Button Content="Bitiş Seç ]" Command="{Binding SetTrimEndFromCurrentPositionCommand}" Padding="8,4" Background="#0284C7" Foreground="White" FontSize="11" FontWeight="Bold" ToolTip="Kırpma bitiş noktasını buraya ayarla"/>
                    </StackPanel>

                    <!-- Volume Control -->
                    <Slider x:Name="VolumeSlider" Grid.Column="5" VerticalAlignment="Center" Minimum="0" Maximum="1" Value="0.8" ValueChanged="VolumeSlider_ValueChanged" ToolTip="Ses Seviyesi"/>
                </Grid>
            </Border>

            <!-- ALT TIMELINE: Kırpma (Trim) İki Modlu Zaman Paneli -->
            <Border Grid.Row="4" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="12">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="✂️ Kırpma (Trim) Zaman İşaretçileri" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="Seçili Bölüm Süresi: " FontSize="13" Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SelectedSectionDurationText}" FontSize="14" FontWeight="Bold" Foreground="#F59E0B" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Trim Start -->
                        <Border Grid.Column="0" Background="#1E293B" CornerRadius="6" Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="🏁 Başlangıç Noktası (saniye):" FontSize="11" Foreground="#94A3B8"/>
                                    <TextBox Text="{Binding TrimStartSeconds, StringFormat={}{0:N1}, UpdateSourceTrigger=PropertyChanged}" FontSize="14" FontWeight="Bold" Padding="4" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Noktayı Buraya Koy" Command="{Binding SetTrimStartFromCurrentPositionCommand}" VerticalAlignment="Bottom" Margin="8,0,0,0" Padding="8,4" Background="#0284C7" Foreground="White" FontSize="11"/>
                            </Grid>
                        </Border>

                        <!-- Trim End -->
                        <Border Grid.Column="2" Background="#1E293B" CornerRadius="6" Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="🏁 Bitiş Noktası (saniye):" FontSize="11" Foreground="#94A3B8"/>
                                    <TextBox Text="{Binding TrimEndSeconds, StringFormat={}{0:N1}, UpdateSourceTrigger=PropertyChanged}" FontSize="14" FontWeight="Bold" Padding="4" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Noktayı Buraya Koy" Command="{Binding SetTrimEndFromCurrentPositionCommand}" VerticalAlignment="Bottom" Margin="8,0,0,0" Padding="8,4" Background="#0284C7" Foreground="White" FontSize="11"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <TextBlock Text="ℹ️ FAST MODE seçildiğinde kesim en yakın ana kareye (keyframe) hizalanır. Tam milisaniyelik uyum için ACCURATE MODE kullanın." 
                               FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- SAĞ PANEL: Export & YouTube Metadata & Queue -->
        <Border Grid.Column="3" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="⚙️ YouTube Metadata &amp; Export" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,12"/>

                    <!-- YouTube Video Title -->
                    <Grid Margin="0,0,0,2">
                        <TextBlock Text="Video Başlığı (Title):" FontSize="12" Foreground="{DynamicResource ForegroundBrush}"/>
                        <TextBlock Text="{Binding TitleLengthText}" FontSize="11" Foreground="#F59E0B" FontWeight="Bold" HorizontalAlignment="Right"/>
                    </Grid>
                    <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" Padding="5" Height="28" MaxLength="100"/>

                    <!-- Description -->
                    <Grid Margin="0,0,0,2">
                        <TextBlock Text="Açıklama (Description):" FontSize="12" Foreground="{DynamicResource ForegroundBrush}"/>
                        <TextBlock Text="{Binding DescriptionLengthText}" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Right"/>
                    </Grid>
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" Padding="5" Height="50" TextWrapping="Wrap" AcceptsReturn="True" MaxLength="5000"/>

                    <!-- Tags -->
                    <TextBlock Text="Etiketler (Virgülle ayırın):" FontSize="12" Foreground="{DynamicResource ForegroundBrush}"/>
                    <TextBox Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" Padding="5" Height="28"/>

                    <!-- Category & Language -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Kategori:" FontSize="11" Foreground="{DynamicResource ForegroundBrush}"/>
                            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" Height="26" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Dil:" FontSize="11" Foreground="{DynamicResource ForegroundBrush}"/>
                            <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" Height="26" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Game Name & Privacy Status -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Oyun Adı:" FontSize="11" Foreground="{DynamicResource ForegroundBrush}"/>
                            <TextBox Text="{Binding GameName, UpdateSourceTrigger=PropertyChanged}" Padding="4" Height="26" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Gizlilik:" FontSize="11" Foreground="{DynamicResource ForegroundBrush}"/>
                            <ComboBox ItemsSource="{Binding PrivacyStatuses}" SelectedItem="{Binding PrivacyStatus}" Height="26" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Playlist & MadeForKids -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Oynatma Listesi:" FontSize="11" Foreground="{DynamicResource ForegroundBrush}"/>
                            <TextBox Text="{Binding PlaylistName, UpdateSourceTrigger=PropertyChanged}" Padding="4" Height="26" Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="2" Content="Çocuklara Özel" IsChecked="{Binding MadeForKids}" VerticalAlignment="Bottom" Margin="0,0,0,4" Foreground="{DynamicResource ForegroundBrush}"/>
                    </Grid>

                    <!-- Draft Actions -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="💾 Taslağı Kaydet" Command="{Binding SaveDraftCommand}" Padding="8,5" Background="#0284C7" Foreground="White" FontWeight="Bold" FontSize="11"/>
                        <Button Grid.Column="2" Content="📤 JSON Dışa Aktar" Command="{Binding ExportDraftJsonCommand}" Padding="8,5" Background="#475569" Foreground="White" FontSize="11"/>
                    </Grid>

                    <!-- Export File & Directory Settings -->
                    <TextBlock Text="Çıktı Dosya Adı:" FontSize="12" Foreground="{DynamicResource ForegroundBrush}"/>
                    <TextBox Text="{Binding OutputFileName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" Padding="5" Height="26"/>

                    <TextBlock Text="Çıktı Klasörü:" FontSize="12" Foreground="{DynamicResource ForegroundBrush}"/>
                    <TextBox Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10" Padding="5" Height="26"/>

                    <!-- Kırpma / Kodlama Profili Seçimi -->
                    <TextBlock Text="Kırpma / Export Modu:" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding ExportProfiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="DisplayName" Margin="0,0,0,4" Height="28"/>
                    <TextBlock Text="{Binding SelectedProfile.Description}" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <!-- Thumbnail Generator Kartı -->
                    <Border Background="#1E293B" CornerRadius="6" Padding="8" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="🖼️ Thumbnail (Küçük Resim)" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,6"/>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" SelectedValuePath="Content" SelectedValue="{Binding SelectedThumbnailFormat}" Height="24">
                                    <ComboBoxItem Content="JPEG"/>
                                    <ComboBoxItem Content="PNG"/>
                                </ComboBox>
                                <TextBlock Grid.Column="1" Text="1280x720 (16:9)" FontSize="10" Foreground="#A7F3D0" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Button Content="📸 Kareyi Yakala" Command="{Binding GrabFrameThumbnailCommand}" Margin="0,0,6,0" Padding="6,3" Background="#0284C7" Foreground="White" FontSize="11"/>
                                <Button Content="📁 Özel Görsel Seç" Command="{Binding BrowseCustomThumbnailCommand}" Padding="6,3" Background="#475569" Foreground="White" FontSize="11"/>
                            </StackPanel>

                            <!-- Thumbnail Live Preview -->
                            <Border Height="80" Background="#000000" CornerRadius="4" ClipToBounds="True">
                                <Image Source="{Binding ThumbnailPath}" Stretch="Uniform"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Render & Upload Action Buttons -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="🚀 Render Al" Command="{Binding EnqueueRenderJobCommand}" Height="34" Background="#10B981" Foreground="White" FontWeight="Bold" FontSize="11" Cursor="Hand"/>
                        <Button Grid.Column="2" Content="▶ Render + YouTube" Command="{Binding EnqueueRenderAndUploadCommand}" Height="34" Background="#8B5CF6" Foreground="White" FontWeight="Bold" FontSize="11" Cursor="Hand" ToolTip="Render tamamlandıktan sonra otomatik YouTube'a yükle"/>
                    </Grid>

                    <Button Content="📤 Hazır Videoyu YouTube'a Yükle" Command="{Binding EnqueueUploadOnlyCommand}" Height="30" Background="#0284C7" Foreground="White" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,8" Cursor="Hand"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#E91E63" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,10"/>

                    <!-- Render Kuyruğu & İlerleme Kartı -->
                    <TextBlock Text="📊 Render Kuyruğu &amp; İlerleme" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,6"/>

                    <ItemsControl ItemsSource="{Binding Jobs}" Margin="0,0,0,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1E293B" CornerRadius="6" Padding="8" Margin="0,0,0,6" BorderBrush="#334155" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="White" FontSize="12" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34"/>
                                        <Grid Margin="0,2,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Status}" FontSize="11" Foreground="#F59E0B" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ProgressPercentage, StringFormat={}{0:N1}%}" FontSize="11" Foreground="#38BDF8" FontWeight="Bold"/>
                                        </Grid>
                                        <ProgressBar Value="{Binding ProgressPercentage}" Minimum="0" Maximum="100" Height="6" Foreground="#10B981" Background="#334155" Margin="0,0,0,4"/>
                                        
                                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                            <Button Content="Sil" Command="{Binding DataContext.DeleteJobCommand, ElementName=StudioViewRoot}" CommandParameter="{Binding}" Background="#64748B" Foreground="White" FontSize="10" Padding="6,2" Margin="0,0,4,4"/>
                                            <Button Content="İptal Et" Command="{Binding DataContext.CancelJobCommand, ElementName=StudioViewRoot}" CommandParameter="{Binding}" Background="#EF4444" Foreground="White" FontSize="10" Padding="6,2" Margin="0,0,0,4"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- YouTube Yükleme Kuyruğu Kartı -->
                    <TextBlock Text="🔴 YouTube Yükleme Kuyruğu" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}" Margin="0,4,0,6"/>

                    <ItemsControl ItemsSource="{Binding UploadJobs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1E293B" CornerRadius="6" Padding="8" Margin="0,0,0,6" BorderBrush="#8B5CF6" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="White" FontSize="12" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34"/>
                                        <Grid Margin="0,2,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <TextBlock Text="{Binding Status}" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding PrivacyStatus, StringFormat='({0})'}" FontSize="10" Foreground="#94A3B8"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding ProgressPercent, StringFormat={}{0:N1}%}" FontSize="11" Foreground="#10B981" FontWeight="Bold"/>
                                        </Grid>
                                        <ProgressBar Value="{Binding ProgressPercent}" Minimum="0" Maximum="100" Height="6" Foreground="#8B5CF6" Background="#334155" Margin="0,0,0,4"/>

                                        <TextBlock Text="{Binding LastError}" Foreground="#EF4444" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,4">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding LastError}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                            <Button Content="📺 YouTube'da Aç" Command="{Binding DataContext.OpenYouTubeVideoCommand, ElementName=StudioViewRoot}" CommandParameter="{Binding YouTubeVideoUrl}" Background="#8B5CF6" Foreground="White" FontSize="10" Padding="6,2" Margin="0,0,4,4">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <Button Content="Tekrar Dene" Command="{Binding DataContext.RetryUploadJobCommand, ElementName=StudioViewRoot}" CommandParameter="{Binding}" Background="#0284C7" Foreground="White" FontSize="10" Padding="6,2" Margin="0,0,4,4">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <Button Content="Sil" Command="{Binding DataContext.DeleteUploadJobCommand, ElementName=StudioViewRoot}" CommandParameter="{Binding}" Background="#64748B" Foreground="White" FontSize="10" Padding="6,2" Margin="0,0,4,4"/>
                                            <Button Content="İptal Et" Command="{Binding DataContext.CancelUploadJobCommand, ElementName=StudioViewRoot}" CommandParameter="{Binding}" Background="#EF4444" Foreground="White" FontSize="10" Padding="6,2" Margin="0,0,0,4"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
