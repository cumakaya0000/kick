<Window x:Class="KickAutoRecorder.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:KickAutoRecorder.App.Views"
        xmlns:converters="clr-namespace:KickAutoRecorder.App.Converters"
        mc:Ignorable="d"
        Title="{Binding AppName}" Height="750" Width="1150"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
    <Window.Resources>
        <converters:StatusToColorConverter x:Key="StatusToColorConverter"/>
        <converters:StatusToStringConverter x:Key="StatusToStringConverter"/>
        <converters:TrackingTextConverter x:Key="TrackingTextConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Navigation Bar -->
        <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="16,12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Logo & Brand Title -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,28,0">
                    <TextBlock Text="KickVideo" FontSize="22" FontWeight="Bold" Foreground="#53FC18"/>
                    <TextBlock Text="Automatic Stream Recorder" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>

                <!-- Navigation Tabs (Dashboard = 0, Streamers = 1, Recordings = 2, Settings = 3) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding SelectTabCommand}" CommandParameter="0" 
                            Content="Dashboard" Padding="18,8" FontSize="13" FontWeight="SemiBold" 
                            Background="#334155" Foreground="White" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                        </Button.Resources>
                    </Button>
                    
                    <Button Command="{Binding SelectTabCommand}" CommandParameter="1" 
                            Content="Yayıncılar" Padding="18,8" FontSize="13" FontWeight="SemiBold" 
                            Background="#0284C7" Foreground="White" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                        </Button.Resources>
                    </Button>

                    <Button Command="{Binding SelectTabCommand}" CommandParameter="2" 
                            Content="Kayıt Geçmişi" Padding="18,8" FontSize="13" FontWeight="SemiBold" 
                            Background="#059669" Foreground="White" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                        </Button.Resources>
                    </Button>

                    <Button Command="{Binding SelectTabCommand}" CommandParameter="3" 
                            Content="Ayarlar" Padding="18,8" FontSize="13" FontWeight="SemiBold" 
                            Background="#475569" Foreground="White" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                        </Button.Resources>
                    </Button>

                    <Button Command="{Binding SelectTabCommand}" CommandParameter="4" 
                            Content="🎬 Video Studio" Padding="18,8" FontSize="13" FontWeight="SemiBold" 
                            Background="#E91E63" Foreground="White" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ToggleThemeCommand}" 
                            Content="{Binding ThemeToggleText}" Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" 
                            Padding="12,7" FontSize="12" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" Margin="0,0,8,0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                        </Button.Resources>
                    </Button>

                    <!-- 5-Second Countdown Timer Badge -->
                    <Border Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,8,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⏱️ Otomatik Yenileme: " FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding AutoRefreshCountdown, StringFormat='{}{0}s'}" FontSize="12" FontWeight="Bold" Foreground="#38BDF8"/>
                        </StackPanel>
                    </Border>

                    <Button Command="{Binding RefreshStatusCommand}" 
                            Content="Sistem Durumunu Yenile" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextSecondaryBrush}" 
                            Padding="14,7" FontSize="12" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Dynamic Content Panel -->
        <Grid Grid.Row="1">
            
            <!-- Dashboard Content (SelectedTabIndex == 0) -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Status Counter Clickable Widgets -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Total Streamers Widget -> Tab 1 -->
                    <Button Grid.Column="0" Command="{Binding SelectTabCommand}" CommandParameter="1" 
                            Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" 
                            Margin="0,0,8,0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="16">
                                    <ContentPresenter/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel>
                            <TextBlock Text="Toplam Yayıncı" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding TotalStreamersCount}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                            <TextBlock Text="Takip edilen kanallar ↗" FontSize="11" Foreground="#0284C7" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Live Streamers Widget -> Tab 1 -->
                    <Button Grid.Column="1" Command="{Binding SelectTabCommand}" CommandParameter="1" 
                            Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" 
                            Margin="4,0,4,0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="16">
                                    <ContentPresenter/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel>
                            <TextBlock Text="Canlı Yayıncılar" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding LiveStreamersCount}" FontSize="26" FontWeight="Bold" Foreground="#53FC18" Margin="0,4,0,0"/>
                            <TextBlock Text="Şu an canlı yayında ↗" FontSize="11" Foreground="#10B981" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Active Recordings Widget -> Tab 2 -->
                    <Button Grid.Column="2" Command="{Binding SelectTabCommand}" CommandParameter="2" 
                            Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" 
                            Margin="4,0,4,0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="16">
                                    <ContentPresenter/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel>
                            <TextBlock Text="Aktif Kayıtlar" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding ActiveRecordingsCount}" FontSize="26" FontWeight="Bold" Foreground="#38BDF8" Margin="0,4,0,0"/>
                            <TextBlock Text="Kayıt geçmişini gör ↗" FontSize="11" Foreground="#059669" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Free Storage Space Widget -> Tab 3 -->
                    <Button Grid.Column="3" Command="{Binding SelectTabCommand}" CommandParameter="3" 
                            Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" 
                            Margin="8,0,0,0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="16">
                                    <ContentPresenter/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel>
                            <TextBlock Text="Kalan Disk Alanı" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding FreeDiskSpaceText}" FontSize="20" FontWeight="Bold" Foreground="#F59E0B" Margin="0,4,0,0"/>
                            <TextBlock Text="Ayarlara git ↗" FontSize="11" Foreground="#D97706" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Scrollable Dashboard Content (Health Telemetry + Streamers Overview) -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Health Telemetry Widget -->
                        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="10" Height="10" Fill="#EF4444" Margin="0,0,8,0"/>
                                        <TextBlock Text="CANLI KAYIT TELEMETRİ MONİTÖRÜ" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding HealthStreamerUsername, StringFormat='Yayıncı: {0}'}" FontSize="13" FontWeight="SemiBold" Foreground="#38BDF8" HorizontalAlignment="Right"/>
                                </Grid>
                                
                                <Separator Background="{DynamicResource CardBorderBrush}" Margin="0,12,0,16"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Süre" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding HealthDurationText}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Dosya Boyutu" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding HealthFileSizeText}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Bitrate" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding HealthBitrateText}" FontSize="18" FontWeight="Bold" Foreground="#53FC18" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="Parça (Segment)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding HealthSegmentCount, StringFormat='{}{0} Parça'}" FontSize="18" FontWeight="Bold" Foreground="#F59E0B" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="FFmpeg Durumu" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding HealthFFmpegState}" FontSize="16" FontWeight="Bold" Foreground="#10B981" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Streamers Overview Section Header -->
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Yayıncılar Aktiflik &amp; Canlılık Durumu Genel Bakış" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <Button Command="{Binding SelectTabCommand}" CommandParameter="1" 
                                    Content="+ Yayıncı Yönetimine Git" HorizontalAlignment="Right"
                                    Background="Transparent" Foreground="#38BDF8" BorderThickness="0" FontSize="12" FontWeight="SemiBold" Cursor="Hand"/>
                        </Grid>

                        <!-- Streamers List Overview Cards -->
                        <ItemsControl ItemsSource="{Binding StreamersViewModel.Streamers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Status Dot -->
                                            <Ellipse Grid.Column="0" Width="12" Height="12" 
                                                     Fill="{Binding CurrentStatus, Converter={StaticResource StatusToColorConverter}}" 
                                                     VerticalAlignment="Center" Margin="0,0,14,0"/>

                                            <!-- Details -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Username}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    
                                                    <!-- Status Badge -->
                                                    <Border Margin="10,0,0,0" Padding="6,2" CornerRadius="4" 
                                                            Background="{Binding CurrentStatus, Converter={StaticResource StatusToColorConverter}}">
                                                        <TextBlock Text="{Binding CurrentStatus, Converter={StaticResource StatusToStringConverter}}" 
                                                                   FontSize="10" FontWeight="Bold" Foreground="White"/>
                                                    </Border>

                                                    <!-- Tracking Badge -->
                                                    <Border Margin="6,0,0,0" Padding="6,2" CornerRadius="4" Background="#334155">
                                                        <TextBlock Text="{Binding IsTrackingEnabled, Converter={StaticResource TrackingTextConverter}}" 
                                                                   FontSize="10" Foreground="#E2E8F0"/>
                                                    </Border>

                                                    <TextBlock Text="{Binding ViewerCount, StringFormat='{} İzleyici: {0:N0}'}" 
                                                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <TextBlock Text="{Binding StreamTitle, TargetNullValue='Yayın başlığı yok'}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>

                                                <!-- Active Recording Telemetry Details if active -->
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRecordingActive}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <Border Background="#059669" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding RecordingStartedAtText, StringFormat='🔴 Başlangıç: {0}'}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                                    </Border>
                                                    <Border Background="#0284C7" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="{Binding RecordingDurationText, StringFormat='⏱️ Süre: {0}'}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Action Buttons -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Manual Record Start -->
                                                <Button Command="{Binding StartRecordingCommand}" 
                                                        Content="▶ Kayıt Başlat" Background="#059669" Foreground="White" 
                                                        Padding="10,5" FontSize="11" FontWeight="Bold" BorderThickness="0" Margin="0,0,6,0" Cursor="Hand">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding CurrentStatus}" Value="Live"/>
                                                                        <Condition Binding="{Binding IsRecordingActive}" Value="False"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <Button.Resources>
                                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                                    </Button.Resources>
                                                </Button>

                                                <!-- Manual Record Stop -->
                                                <Button Command="{Binding StopRecordingCommand}" 
                                                        Content="⏹ Kayıdı Durdur" Background="#DC2626" Foreground="White" 
                                                        Padding="10,5" FontSize="11" FontWeight="Bold" BorderThickness="0" Margin="0,0,6,0" Cursor="Hand">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRecordingActive}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <Button.Resources>
                                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                                    </Button.Resources>
                                                </Button>

                                                <!-- Toggle Tracking -->
                                                <Button Command="{Binding ToggleTrackingCommand}" 
                                                        Content="{Binding IsTrackingEnabled, Converter={StaticResource TrackingTextConverter}}" 
                                                        Background="#334155" Foreground="White" Padding="10,5" 
                                                        FontSize="11" FontWeight="SemiBold" Cursor="Hand">
                                                    <Button.Resources>
                                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                                    </Button.Resources>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Streamers Management View (SelectedTabIndex == 1) -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                
                <views:StreamersView DataContext="{Binding StreamersViewModel}"/>
            </Grid>

            <!-- Recordings History View (SelectedTabIndex == 2) -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="2">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                
                <views:RecordingsView DataContext="{Binding RecordingsViewModel}"/>
            </Grid>

            <!-- Settings View (SelectedTabIndex == 3) -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="3">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                
                <views:SettingsView DataContext="{Binding SettingsViewModel}"/>
            </Grid>

            <!-- Video Studio View (SelectedTabIndex == 4) -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="4">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <views:VideoStudioView DataContext="{Binding VideoStudioViewModel}"/>
            </Grid>

        </Grid>

        <!-- Footer / Status Bar -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="12,10" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="10" Height="10" Fill="#10B981" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding SystemStatus}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
