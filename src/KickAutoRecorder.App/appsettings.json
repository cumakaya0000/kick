{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=kickvideodata.db"
  },
  "RecordingSettings": {
    "OutputFolder": "Recordings",
    "MinDiskSpaceGB": 5
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": "Debug",
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/kickvideo-.log",
          "rollingInterval": "Day"
        }
      }
    ]
  }
}
